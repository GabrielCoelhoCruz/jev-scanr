{
  "name": "jev-scanr",
  "version": "0.3.0-alpha",
  "description": "A refactoring queue for TypeScript and JavaScript projects, judged by the Jev model. Unofficial, not affiliated with TypeSafe.",
  "keywords": [
    "jev",
    "typesafe",
    "refactoring",
    "code-quality",
    "coding-agents",
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielCoelhoCruz/jev-scanr.git"
  },
  "homepage": "https://github.com/GabrielCoelhoCruz/jev-scanr#readme",
  "bugs": {
    "url": "https://github.com/GabrielCoelhoCruz/jev-scanr/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "jev-scanr": "./src/cli.mjs",
    "jevs": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "signals",
    "catalog.json",
    "licenses",
    "docs",
    "skills",
    "examples",
    "NOTICE.md",
    "EVIDENCE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "!examples/demo-app/expected"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "ci": "npm run check && npm test",
    "scan": "node src/cli.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "@babel/traverse": "7.28.5",
    "@typesafe-ai/sdk": "0.6.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "prettier": "3.6.2"
  }
}
